{
  "$schema": "hq-hook-registry@1",
  "description": "Gated hooks dispatched in-process by .claude/hooks/master-hook.sh. Same event/matcher semantics as settings.json hooks. prefilter.re is a POSIX ERE tested against the JSON text of tool_input (or the prompt for UserPromptSubmit); the hook only runs when it matches (must be a superset of the hook's own trigger). prefilter.env requires a non-empty env var; prefilter.file requires a path under the HQ root to exist. prefilter.policy_vocab=true skips the policy injector when the tool text contains none of the tokens any tool-event policy requires (compiled by master-hook from the policy dirs).",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "id": "block-hq-worktree-session",
            "script": ".claude/hooks/block-hq-worktree-session.sh",
            "timeout": 30,
            "gated": true,
            "args": [
              "PreToolUse"
            ]
          }
        ]
      },
      {
        "matcher": "Glob",
        "hooks": [
          {
            "id": "block-hq-glob",
            "script": ".claude/hooks/block-hq-glob.sh",
            "timeout": 30,
            "gated": true
          },
          {
            "id": "mandatory-scope-authorizer",
            "script": ".claude/hooks/mandatory-scope-authorizer.sh",
            "timeout": 30,
            "gated": true
          },
          {
            "id": "conduct-lane-inbox",
            "script": ".claude/hooks/conduct-lane-inbox.sh",
            "timeout": 30,
            "gated": true,
            "prefilter": {
              "env": "HQ_CONDUCT_RUN_DIR"
            }
          }
        ]
      },
      {
        "matcher": "Grep",
        "hooks": [
          {
            "id": "block-hq-grep",
            "script": ".claude/hooks/block-hq-grep.sh",
            "timeout": 30,
            "gated": true,
            "prefilter": {
              "re": "prd\\.json|worker\\.yaml"
            }
          },
          {
            "id": "mandatory-scope-authorizer",
            "script": ".claude/hooks/mandatory-scope-authorizer.sh",
            "timeout": 30,
            "gated": true
          },
          {
            "id": "conduct-lane-inbox",
            "script": ".claude/hooks/conduct-lane-inbox.sh",
            "timeout": 30,
            "gated": true,
            "prefilter": {
              "env": "HQ_CONDUCT_RUN_DIR"
            }
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "id": "mandatory-scope-authorizer",
            "script": ".claude/hooks/mandatory-scope-authorizer.sh",
            "timeout": 30,
            "gated": true
          },
          {
            "id": "warn-cross-company-settings",
            "script": ".claude/hooks/warn-cross-company-settings.sh",
            "timeout": 30,
            "gated": true,
            "prefilter": {
              "re": "companies/[^/\"]+/settings/"
            }
          },
          {
            "id": "conduct-lane-inbox",
            "script": ".claude/hooks/conduct-lane-inbox.sh",
            "timeout": 30,
            "gated": true,
            "prefilter": {
              "env": "HQ_CONDUCT_RUN_DIR"
            }
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "id": "mandatory-scope-authorizer",
            "script": ".claude/hooks/mandatory-scope-authorizer.sh",
            "timeout": 30,
            "gated": true
          },
          {
            "id": "detect-secrets",
            "script": ".claude/hooks/detect-secrets.sh",
            "timeout": 30,
            "gated": true,
            "prefilter": {
              "re": "sk-[a-zA-Z0-9._-]{20,}|ghp_|gho_|github_pat_|AKIA[0-9A-Z]{16}|xox[bpsa]-|Bearer |BEGIN [A-Z ]*PRIVATE KEY|glpat-"
            }
          },
          {
            "id": "block-env-dump",
            "script": ".claude/hooks/block-env-dump.sh",
            "timeout": 30,
            "gated": true,
            "prefilter": {
              "re": "printenv|(^|[^A-Za-z0-9_])(env|set)([^A-Za-z0-9_]|$)|export[[:space:]]+-p|declare[[:space:]]+-x|/proc/self/environ|/proc/[0-9]+/environ|docker inspect|docker exec|\\.env"
            }
          },
          {
            "id": "block-core-writes-bash",
            "script": ".claude/hooks/block-core-writes-bash.sh",
            "timeout": 30,
            "gated": true,
            "prefilter": {
              "re": "core|\\.claude|\\.agents|\\.codex|\\.obsidian|AGENTS\\.md|_template|(^|[^A-Za-z0-9_])(rm|rmdir|mv|cp|tee|dd|rsync|ln|sed|awk|truncate|install|touch|mkdir|chmod|chown|git|tar|find|xargs|perl|python[0-9]*|node|bash|sh|zsh|eval|source)([^A-Za-z0-9_]|$)|>"
            }
          },
          {
            "id": "block-policy-writes-bash",
            "script": ".claude/hooks/block-policy-writes-bash.sh",
            "timeout": 30,
            "gated": true,
            "prefilter": {
              "re": "polic|HQ_ALLOW_POLICY_WRITE|(^|[^A-Za-z0-9_])(tar|find|git|cp|mv|rsync|xargs)([^A-Za-z0-9_]|$)"
            }
          },
          {
            "id": "enforce-vault-write-access",
            "script": ".claude/hooks/enforce-vault-write-access.sh",
            "timeout": 30,
            "gated": true,
            "prefilter": {
              "file": ".hq/vault-access.json"
            }
          },
          {
            "id": "block-hq-root-git-mutation",
            "script": ".claude/hooks/block-hq-root-git-mutation.sh",
            "timeout": 30,
            "gated": true,
            "prefilter": {
              "re": "(^|[^A-Za-z0-9_-])(git|gh)([^A-Za-z0-9_-]|$)"
            }
          },
          {
            "id": "block-foreground-timeout-over-harness-ceiling",
            "script": ".claude/hooks/block-foreground-timeout-over-harness-ceiling.sh",
            "timeout": 30,
            "gated": true,
            "prefilter": {
              "re": "timeout|alarm"
            }
          },
          {
            "id": "block-qmd-model-download",
            "script": ".claude/hooks/block-qmd-model-download.sh",
            "timeout": 30,
            "gated": true,
            "prefilter": {
              "re": "qmd"
            }
