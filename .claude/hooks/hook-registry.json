            "timeout": 30,
            "gated": true,
            "prefilter": {
              "re": "(^|[^A-Za-z0-9_])(npm|pnpm|yarn|bun|npx|bunx|pip[0-9]*|uv|poetry|pipx|gem|cargo|go|brew|apt|apt-get|curl|wget)([^A-Za-z0-9_]|$)"
            }
          },
          {
            "id": "surface-company-infra-policy",
            "script": ".claude/hooks/surface-company-infra-policy.sh",
            "timeout": 30,
            "gated": true,
            "prefilter": {
              "re": "sst|deploy|cdk|serverless|sls|terraform|aws|secrets"
            }
          },
          {
            "id": "conduct-lane-inbox",
            "script": ".claude/hooks/conduct-lane-inbox.sh",
            "timeout": 30,
            "gated": true,
            "prefilter": {
              "env": "HQ_CONDUCT_RUN_DIR"
            }
          }
