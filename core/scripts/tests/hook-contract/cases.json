{
  "schema_version": "hq-hook-contract.v1",
  "cases": [
    {
      "id": "first-block-alone",
      "event": "PreToolUse",
      "children": [
        {
          "output": "advisory",
          "exit": 0
        },
        {
          "output": {
            "ok": true
          },
          "exit": 0
        },
        {
          "output": {
            "decision": "block",
            "reason": "first"
          },
          "exit": 0
        },
        {
          "output": {
            "hookSpecificOutput": {
              "permissionDecision": "deny",
              "permissionDecisionReason": "first"
            }
          },
          "exit": 0
        }
      ],
      "expected": {
        "exit": 0,
        "json": {
          "decision": "block",
          "reason": "first",
          "hookSpecificOutput": {
            "hookEventName": "PreToolUse",
            "hqSessionBlockedBy": "$FIXTURE/core/hooks/PreToolUse/02-child.sh"
          }
        }
      }
    },
    {
      "id": "first-deny-alone",
      "event": "PreToolUse",
      "children": [
        {
          "output": "advisory",
          "exit": 0
        },
        {
          "output": {
            "hookSpecificOutput": {
              "permissionDecision": "deny",
              "permissionDecisionReason": "first"
            }
          },
          "exit": 0
        },
        {
          "output": {
            "decision": "block",
            "reason": "first"
          },
          "exit": 0
        }
      ],
      "expected": {
        "exit": 0,
        "json": {
          "hookSpecificOutput": {
            "permissionDecision": "deny",
            "permissionDecisionReason": "first",
            "hookEventName": "PreToolUse",
            "hqSessionBlockedBy": "$FIXTURE/core/hooks/PreToolUse/01-child.sh"
          }
        }
      }
    },
    {
      "id": "single-block-provenance",
      "event": "PreToolUse",
      "children": [
        {
          "output": {
            "decision": "block",
            "reason": "first"
          },
          "exit": 0
        }
      ],
      "expected": {
        "exit": 0,
        "json": {
          "decision": "block",
          "reason": "first",
          "hookSpecificOutput": {
            "hookEventName": "PreToolUse",
            "hqSessionBlockedBy": "$FIXTURE/core/hooks/PreToolUse/00-child.sh"
          }
        }
      }
    },
    {
      "id": "exception-lone-deny-without-provenance",
      "event": "PreToolUse",
      "children": [
        {
          "output": {
            "hookSpecificOutput": {
              "permissionDecision": "deny",
              "permissionDecisionReason": "first"
            }
          },
          "exit": 0
        }
      ],
      "expected": {
        "exit": 0,
        "json": {
          "hookSpecificOutput": {
            "permissionDecision": "deny",
            "permissionDecisionReason": "first"
          }
        }
      },
      "exception": "Operator-approved current-bash baseline: a lone permissionDecision deny is emitted without hookEventName or hqSessionBlockedBy. Any change to this behavior needs a separate, reviewed change."
    },
    {
      "id": "later-top-level-key-wins",
      "event": "PreToolUse",
      "children": [
        {
          "output": {
            "value": 1,
            "keep": true
          },
          "exit": 0
        },
        {
          "output": {
            "value": 2
          },
          "exit": 0
        }
      ],
      "expected": {
        "exit": 0,
        "json": {
          "value": 2,
          "keep": true
        }
      }
    },
    {
      "id": "exception-recursive-nested-merge",
      "event": "PreToolUse",
      "children": [
        {
          "output": {
            "value": {
              "old": 1,
              "replace": 1
            }
          },
          "exit": 0
        },
        {
          "output": {
            "value": {
              "replace": 2
            }
          },
          "exit": 0
        }
      ],
      "expected": {
        "exit": 0,
        "json": {
          "value": {
            "replace": 2,
            "old": 1
          }
        }
      },
      "exception": "Operator-approved current-bash baseline: nested objects merge recursively, despite the stated shallow contract. Any change to this behavior needs a separate, reviewed change."
    },
    {
      "id": "context-in-hook-order",
      "event": "PreToolUse",
      "children": [
        {
          "output": {
            "hookSpecificOutput": {
              "additionalContext": "first"
            }
          },
          "exit": 0
        },
        {
          "output": {
            "hookSpecificOutput": {
              "additionalContext": ""
            }
          },
          "exit": 0
        },
        {
          "output": {
            "hookSpecificOutput": {
              "additionalContext": "second"
            }
          },
          "exit": 0
        }
      ],
      "expected": {
        "exit": 0,
        "json": {
          "hookSpecificOutput": {
            "additionalContext": "first\n\nsecond"
          }
        }
      }
    },
